# For `pnpm deploy:sepolia`. Never commit a real .env.
SEPOLIA_RPC_URL=
OWNER_KEY=
AGENT_KEY_ADDRESS=
# Three addresses, comma-separated.
VERIFIER_ADDRESSES=
TREASURY_ADDRESS=
# CRE's forwarder. For simulation on Sepolia, use the MockKeystoneForwarder from the CRE docs.
ATTEST_FORWARDER=
# The deployed workflow's id. With this set, the ledger only accepts that workflow's reports.
ATTEST_WORKFLOW_ID=
# Leave USDC empty to deploy a test token. To use Circle's, set it and scale pools to what you hold.
USDC=
DEPTH_BPS=10000
ACCOUNT_USDC=
USDC_DAILY_CAP=
# Price sources for the CRE workflow, declared in cre/secrets.yaml. Without both, the workflow writes no attestation.
# A CoinGecko demo key: https://www.coingecko.com/en/api
COINGECKO_API_KEY=
# Your name becomes <ENS_AGENT_LABEL>.<ENS_PARENT_LABEL>.eth
ENS_PARENT_LABEL=
ENS_AGENT_LABEL=alice
# The owner's World ID subject, from your first login.
OWNER_SUB=
# Optional: a key allowed to change clearance.maxImpactBps and nothing else.
LIMIT_OPERATOR=

# Each verifier needs a different provider: anthropic, openai, google or 0g. Without these, rules decide alone.
# For 0g, use an sk- key from https://pc.0g.ai and a model with TeeML verifiability, such as glm-5.3.
VERIFIER1_PROVIDER=
VERIFIER1_MODEL=
VERIFIER1_API_KEY=
VERIFIER2_PROVIDER=
VERIFIER2_MODEL=
VERIFIER2_API_KEY=
VERIFIER3_PROVIDER=
VERIFIER3_MODEL=
VERIFIER3_API_KEY=

# For `pnpm review:0g`, which runs one real review on 0G and prints its request id.
ZG_API_KEY=
ZG_MODEL=
ZG_BASE_URL=

# World ID. The sandbox issuer is https://sandbox.auth.world.org
WORLD_ISSUER=
WORLD_JWKS_URI=
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=

# Launa's testnet facilitator. Leave empty to settle yourself with a funded X402_FACILITATOR_KEY.
X402_FACILITATOR_URL=https://testnet.facilitator.launa.dev
X402_FACILITATOR_KEY=
