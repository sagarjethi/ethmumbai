{
  "name": "beforecoin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "test": "pnpm test:contracts && pnpm test:ts",
    "test:contracts": "cd contracts && forge test",
    "test:ts": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "demo": "tsx apps/agent/src/demo.ts",
    "start": "tsx scripts/up.ts",
    "start:public": "tsx scripts/public.ts",
    "deploy:sepolia": "tsx scripts/sepolia.ts",
    "review:0g": "tsx scripts/0g-review.ts",
    "test:cre": "cd cre/attest && bun install --frozen-lockfile && bun test",
    "test:fork": "SEPOLIA_FORK_URL=${SEPOLIA_FORK_URL:-https://ethereum-sepolia-rpc.publicnode.com} vitest run --no-file-parallelism tests/ens-fork.test.ts tests/sepolia-fork.test.ts"
  },
  "devDependencies": {
    "@clearance/agent": "workspace:*",
    "@clearance/api": "workspace:*",
    "@clearance/mock-world": "workspace:*",
    "@clearance/shared": "workspace:*",
    "@clearance/verifier": "workspace:*",
    "@hono/node-server": "^1.19.18",
    "@types/node": "^24.19.2",
    "hono": "^4.13.16",
    "jose": "^5.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "viem": "^2.57.16",
    "vitest": "^3.2.7",
    "@clearance/mcp": "workspace:*"
  }
}