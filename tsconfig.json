{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "exclude": ["apps/web", "apps/site", "cre"], "include": ["packages/*/src", "apps/verifier/src", "apps/api/src", "apps/agent/src", "apps/mcp/src", "apps/mock-world/src", "apps/gateway/src", "scripts", "tests", "skills"]
}
